PORT=3000
DATABASE_PATH=./data/flood-finder.sqlite
# Use production only with HTTPS proxy/reverse proxy
NODE_ENV=development
TRUST_PROXY=0
# Legacy statewide alert endpoint only; the map discovers state from the search point.
NWS_AREAS=FL
NWS_USER_AGENT=FloodFinder/1.0 (your-public-contact@example.com)
# Optional: self-host OSRM in production (public demo not guaranteed)
OSRM_URL=https://router.project-osrm.org

